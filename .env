# ============================================
# AI Career Counselor — Environment Variables
# ============================================
# Copy this file to `.env` (already gitignored) when chạy local.
# Khi deploy trên Lovable, các biến này được Lovable Cloud tự inject — KHÔNG cần tạo .env trên Lovable.

# ----- Backend (Lovable Cloud / Supabase) -----
# Lấy từ Lovable Cloud → Connect, hoặc Supabase project Settings → API.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGc..."   # anon/publishable key, public OK
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"

# ----- Edge function secrets (chỉ cần khi tự deploy edge functions local) -----
# LOVABLE_API_KEY=...        # cho Lovable AI Gateway
# ADMIN_EMAILS=you@x.com     # allowlist truy cập /admin
